<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID signed release (hardened runtime, no App
  Sandbox). This is Wails v3's "production" preset (`wails3 setup
  entitlements`): network.client only. No JIT/unsigned-memory exceptions are
  needed because WKWebView runs JavaScript in Apple's own WebContent process,
  not in Pakpos's. Used by build/darwin/sign-notarize.sh.
-->
<plist version="1.0">
	<dict>
		<key>com.apple.security.network.client</key>
		<true/>
	</dict>
</plist>
