---
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Screenshot from "../components/Screenshot.astro";
import { REPO_URL } from "../lib/paths";

const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: "send",
    title: "Every kind of request",
    body: "All common methods; query and path parameters synced with the URL; JSON, XML, form-data with files, urlencoded and binary bodies. Override the timeout, redirects and TLS checks per request.",
  },
  {
    icon: "chart",
    title: "Readable responses",
    body: "Status, size and a timing breakdown; pretty, raw and preview views; headers, cookies and test results. The Debug tab shows every hop on the wire, redirects included, with secrets masked.",
  },
  {
    icon: "key",
    title: "Auth for real APIs",
    body: "Basic, Bearer and API key, plus OAuth 2.0 (authorization code with PKCE, client credentials, password, implicit) with automatic refresh, Digest, NTLM, AWS Signature v4, Hawk and signed JWTs.",
  },
  {
    icon: "flask",
    title: "Scripts and tests",
    body: "Pre-request and test scripts in JavaScript, with the <code>pm</code> API and <code>expect</code> assertions you already know. Set them on a request, folder or collection; logs land in the console.",
  },
  {
    icon: "listChecks",
    title: "Collection runner",
    body: "Run a collection or folder in order, for many iterations or one per row of a CSV or JSON data file. Branch with <code>setNextRequest</code>, then export the run as a JSON or HTML report.",
  },
  {
    icon: "folder",
    title: "Collections and folders",
    body: "Nest folders and reorder with drag and drop. Set auth, headers and scripts once on a collection or folder and every request inside inherits them.",
  },
  {
    icon: "braces",
    title: "Environments and variables",
    body: "Switch between Dev, Staging and Prod in one click. Use <code>{{variables}}</code> anywhere, with highlighting, hover and autocomplete, plus dynamic ones like <code>{{$guid}}</code>.",
  },
  {
    icon: "lock",
    title: "Secrets stay secret",
    body: "Secret values and OAuth tokens go into your OS keychain, or a file encrypted with a master password. Workspace files only name them, so they're safe to commit.",
  },
  {
    icon: "network",
    title: "Proxies, certificates and cookies",
    body: "Use the system proxy or your own, trust a custom CA, and send client certificates (PEM or PKCS#12) per host. A cookie manager lets you view, edit and clear the jar.",
  },
  {
    icon: "code",
    title: "cURL and code",
    body: "Paste a <code>curl</code> command straight into the URL bar. Copy any request as cURL, or generate code for JavaScript, Python, Go, Java and PHP.",
  },
  {
    icon: "wrench",
    title: "Built-in tools",
    body: "A JWT decoder, JSON formatter, URL encoder, hash and HMAC, Base64, timestamp converter and UUID/ULID generator, each in its own tab and able to read your variables.",
  },
  {
    icon: "history",
    title: "History, examples and palette",
    body: "Every send is kept per workspace. Save responses as examples, checked for leaked secrets first. Press <code>Ctrl+K</code> (<code>⌘K</code>) to reach any request or action.",
  },
];

// Syntax-coloured samples, as HTML (their {{braces}} would otherwise be Astro expressions).
const k = (s: string) => `<span class="k">${s}</span>`;
const s = (v: string) => `<span class="s">${v}</span>`;
const n = (v: string) => `<span class="n">${v}</span>`;
const v = (name: string) => `<span class="var">{{${name}}}</span>`;

const requestFile = `<span class="c"># billing-api/invoices/list-invoices.yaml</span>
${k("id")}: ${s("01J9X2B7Q8N5M3K1H0G6F4D2C0")}
${k("name")}: ${s("List invoices")}
${k("seq")}: ${n("1")}
${k("method")}: ${s("GET")}
${k("url")}: ${s(`${v("baseUrl")}/v1/invoices?status=open`)}
${k("query")}:
  - ${k("key")}: ${s("status")}
    ${k("value")}: ${s("open")}
    ${k("enabled")}: ${n("true")}
${k("headers")}:
  - ${k("key")}: ${s("Accept")}
    ${k("value")}: ${s("application/json")}
    ${k("enabled")}: ${n("true")}
${k("body")}:
  ${k("type")}: ${s("none")}
${k("auth")}:
  ${k("type")}: ${s("inherit")}`;
---

<Base
  title="Pakpos: a free desktop REST API client"
  description="Pakpos is a free, open-source REST API client for Linux, macOS and Windows. Scripts, tests, a collection runner, OAuth 2.0 and built-in developer tools, with your requests in your own folder as plain YAML, ready for git. No account needed."
>
  <main id="main">
    <div class="hero">
      <div class="wrap">
        <p class="eyebrow">Free and open source · Linux, macOS, Windows</p>
        <h1>A fast, quiet REST client that keeps your requests in your own files</h1>
        <p class="lede">
          Pakpos builds, sends and saves HTTP requests. Each request is a small YAML file in a folder you
          choose, so your API collection lives next to your code and goes through git like everything else.
        </p>
        <div class="actions">
          <DownloadButton />
          <a class="btn" href={REPO_URL}>
            View source on GitHub
          </a>
        </div>
        <p class="fineprint">Free forever. No account, no sign-in, no paid tier.</p>

        <Screenshot
          name="hero"
          class="hero-shot"
          alt="The Pakpos window: a Billing API collection with folders, a POST request with a JSON body and a {{baseUrl}} variable, and its 201 Created response with 3 of 3 tests passing."
          loading="eager"
        />
      </div>
    </div>

    <section id="features">
      <div class="wrap">
        <div class="section-head">
          <h2>Everything you need for REST, nothing you don't</h2>
          <p>
            A dense, keyboard-friendly tool that starts fast and stays out of your way. Requests go out from a
            native HTTP client, so CORS never gets in the way, and updates install only when their signature
            checks out.
          </p>
        </div>
        <div class="grid">
          {features.map((f) => (
            <div class="card">
              <span class="icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p set:html={f.body} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="testing">
      <div class="wrap">
        <div class="section-head">
          <h2>Test your API as you build it</h2>
          <p>
            Write checks next to the request, then run the whole collection when you want the full picture.
          </p>
        </div>
        <Screenshot
          name="tests"
          alt="The Scripts tab of a request with a test script in JavaScript, and the response's Tests tab listing three passed tests."
        />
        <ul class="checks columns">
          <li>
            <strong>Familiar scripts:</strong> <code>pm.test</code>, <code>pm.expect</code> and{" "}
            <code>pm.environment</code>, run in a sandbox with no network or file access.
          </li>
          <li>
            <strong>Chain requests</strong> by saving a token or id from one response and using it in the
            next.
          </li>
          <li>
            <strong>Data-driven runs</strong> from CSV or JSON, with a pass/fail summary per request.
          </li>
          <li>
            <strong>Shareable reports</strong> as JSON or a standalone HTML page; secrets are masked.
          </li>
        </ul>
      </div>
    </section>

    <section id="files">
      <div class="wrap split">
        <div class="section-head">
          <h2>Your workspace is just a folder</h2>
          <p>No cloud sync and no lock-in. Pakpos reads and writes plain files you can open in any editor.</p>
          <ul class="checks">
            <li>
              <strong>One request per file,</strong> so pull-request diffs stay small and readable.
            </li>
            <li>
              <strong>Commit it with your code</strong> and the whole team gets the same collection.
            </li>
            <li>
              <strong>Edit outside the app;</strong> Pakpos notices the change and reloads.
            </li>
            <li>
              <strong>History and settings stay local,</strong> on your machine only.
            </li>
          </ul>
        </div>
        <pre class="code" aria-label="Example request file" set:html={requestFile} />
      </div>
    </section>

    <section class="free">
      <div class="wrap">
        <div class="section-head">
          <h2>Free. Really.</h2>
          <p>
            Pakpos is open source under the Apache 2.0 license. Every feature is free for personal and
            commercial use, with no account, no trial and no paid plan.
          </p>
        </div>
        <div class="actions">
          <DownloadButton />
        </div>
      </div>
    </section>
  </main>
</Base>
