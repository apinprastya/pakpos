import requests

url = "https://example.com/login"

headers = {
    "Content-Type": "application/x-www-form-urlencoded",
}

payload = {
    "user": "jane@example.com",
    "pass": "p&ss word",
    "odd key": "v=1",
}

response = requests.post(url, headers=headers, data=payload)

print(response.status_code)
print(response.text)
