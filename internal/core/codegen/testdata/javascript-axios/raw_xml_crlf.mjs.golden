import axios from "axios";

const response = await axios.request({
  method: "post",
  url: "https://example.com/soap",
  headers: {
    "Content-Type": "application/xml",
  },
  data: "<a>\r\n  <b>x</b>\r\n</a>",
  validateStatus: () => true,
});

console.log(response.status);
console.log(response.data);
