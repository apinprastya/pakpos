import axios from "axios";

const response = await axios.request({
  method: "post",
  url: "https://example.com/notes",
  headers: {
    "Content-Type": "text/plain",
  },
  data: `first line
second \`line\` with café	tab`,
  validateStatus: () => true,
});

console.log(response.status);
console.log(response.data);
