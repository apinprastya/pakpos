<?php

$curl = curl_init();

curl_setopt_array($curl, [
    CURLOPT_URL => 'https://api.example.com/orders',
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_CUSTOMREQUEST => 'POST',
    CURLOPT_HTTPHEADER => [
        'X-Request-Id: 7f9c',
        'Content-Type: application/json',
    ],
    CURLOPT_HTTPAUTH => CURLAUTH_BASIC,
    CURLOPT_USERPWD => 'jane:{{password}}',
    CURLOPT_POSTFIELDS => '{"note": "it\'s \\"quoted\\" \\\\ $x ${y}", "items": [{"sku": "A-1", "qty": 2}], "gift": true, "ref": null, "price": 1.5e2, "empty": {}, "none": []}',
]);

$response = curl_exec($curl);

if ($response === false) {
    echo 'Request failed: ' . curl_error($curl) . PHP_EOL;
} else {
    echo curl_getinfo($curl, CURLINFO_RESPONSE_CODE) . PHP_EOL;
    echo $response . PHP_EOL;
}
