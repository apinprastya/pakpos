const response = await fetch("https://example.com/login", {
  method: "POST",
  headers: {
    "Content-Type": "application/x-www-form-urlencoded",
  },
  body: new URLSearchParams({
    "user": "jane@example.com",
    "pass": "p&ss word",
    "odd key": "v=1",
  }),
});

console.log(response.status);
console.log(await response.text());
